# Путь к SQLite-базе (для Postgres: postgresql://user:pass@host:5432/db и provider в schema.prisma)
DATABASE_URL="file:./dev.db"
# Секрет подписи JWT-сессий, минимум 32 символа: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Данные администратора для сидирования
ADMIN_PHONE="+79990000000"
ADMIN_PASSWORD="change-me-admin-password"
ADMIN_NAME="Администратор IBR"
# 1 — создать демо-инвесторов при сидировании
SEED_DEMO=0
# false — отключить флаг Secure у cookie (только для запуска по http без HTTPS)
COOKIE_SECURE=true
# Каталог для загруженных фото (вне public)
UPLOAD_DIR="storage/uploads"
